{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Forge App: Debug Tunnel",
      "program": "${workspaceFolder}/node_modules/@forge/cli/bin/forge.js",
      "args": ["tunnel"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "env": {
        "FORGE_DEV": "true"
      }
    }
  ]
}
